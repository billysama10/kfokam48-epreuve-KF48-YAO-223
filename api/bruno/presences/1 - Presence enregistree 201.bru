meta {
  name: 1 - Présence enregistrée 201
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/presences
  body: json
  auth: none
}

body:json {
  {
    "code": "{{code}}",
    "etudiantId": {{etudiantId}}
  }
}

assert {
  res.status: eq 201
  res.body.source: eq ETUDIANT
}

docs {
  EF3, RG6 : cas nominal. À lancer juste après « 0 - Ouvrir une session ».
}
